# Vite env vars (must start with VITE_ to reach the SPA bundle)

# Supabase → Project Settings → API (anon public key — safe to expose, RLS is
# not the trust boundary here; the API is)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Full URL of the deployed API (Render). Leave empty in dev — Vite proxies /api.
# VITE_API_URL=https://cso-registry-api.onrender.com/api/v1

# Comma-separated extra API origins to allow (CORS on the Render side) — copy
# your Vercel production + preview domains into apps/api CORS_ORIGINS after deploy.
