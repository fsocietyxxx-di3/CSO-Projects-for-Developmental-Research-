# Copy to .env and fill in (see docs/supabase-setup.md checklist)

NODE_ENV=development
PORT=4000

# Supabase → Project Settings → Database → Connection string (use the SESSION POOLER port 5432)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API
SUPABASE_URL="https://<ref>.supabase.co"
# Optional override — defaults to $SUPABASE_URL/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=
# Optional — ONLY set if your project still uses the legacy HS256 JWT secret
# SUPABASE_JWT_SECRET=
# Required ONLY for the admin "create president account" route (service_role key)
# SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated SPA origins (dev + deployed preview/prod URLs)
CORS_ORIGINS=http://localhost:5173

# Local dev shortcut that injects a fake ADMIN user instead of verifying Supabase tokens.
# NEVER set to true in production.
DEV_BYPASS_AUTH=false
