{
  "name": "cso-registry",
  "version": "0.1.0",
  "private": true,
  "description": "CSO Management & Member Registry System — Civil Society Desk Office, Bacoor City",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
